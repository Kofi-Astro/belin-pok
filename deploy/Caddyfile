# Serves the compiled admin app (apps/admin-web, built by Vite into /srv)
# on Railway -- see apps/admin-web/Dockerfile. Railway terminates HTTPS in
# front of this, so Caddy only speaks plain HTTP on the port Railway
# assigns ($PORT).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# index.html must always be revalidated, or browsers keep running an old
	# build after a deploy. (The service-worker and version.json paths are
	# left over from the Flutter builds this used to serve; harmless.)
	# Everything else gets an hour's cache. Vite content-hashes the files
	# under /assets, so those could safely be cached far longer.
	@entrypoints path / /index.html /flutter_service_worker.js /version.json
	@assets not path / /index.html /flutter_service_worker.js /version.json
	header @entrypoints Cache-Control "no-cache"
	header @assets Cache-Control "public, max-age=3600"

	# The admin uses real paths (/products/<id>, /orders/<id>...), handled by
	# its router in the browser. Any path that isn't an actual file gets
	# index.html, so those links work when opened directly or refreshed.
	try_files {path} /index.html
	file_server
}
