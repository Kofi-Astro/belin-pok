# Serves a compiled Flutter web app (apps/admin or apps/storefront) on
# Railway -- see the Dockerfile next to each app. Railway terminates HTTPS
# in front of this, so Caddy only speaks plain HTTP on the port Railway
# assigns ($PORT).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# index.html, the service worker and version.json must always be
	# revalidated, or browsers keep running an old build after a deploy.
	# Flutter doesn't content-hash its other filenames either, so they
	# get a short cache rather than a long one.
	@entrypoints path / /index.html /flutter_service_worker.js /version.json
	@assets not path / /index.html /flutter_service_worker.js /version.json
	header @entrypoints Cache-Control "no-cache"
	header @assets Cache-Control "public, max-age=3600"

	# The apps use hash routing (/#/...), so every real request is for an
	# actual file -- this fallback only matters if someone types a bare path.
	try_files {path} /index.html
	file_server
}
