{
  // Same reasoning as apps/admin/wrangler.jsonc: without this, `wrangler
  // deploy` (the dashboard's default Deploy command) guesses an assets
  // directory from folder names and picks "web" (the unbuilt Flutter
  // source template) instead of "build/web" (the actual compiled
  // output). This pins it explicitly.
  // This is a SEPARATE Cloudflare Pages/Workers project from apps/admin
  // -- a different Worker name here keeps the two from colliding, since
  // each is deployed from its own project with its own custom domain
  // (storefront on the bare belpok.xyz / www.belpok.xyz, admin on
  // admin.belpok.xyz -- see the README's Deployment section). Keep this
  // name matching whatever Worker is already deployed/wired to
  // belpok.xyz -- renaming it here would deploy a *second*,
  // differently-named Worker instead of updating the existing one.
  // "belin-pok-storefront" (not "belpok-storefront") because that's what
  // the Cloudflare project actually auto-named itself when it was
  // created from this repo.
  "name": "belin-pok-storefront",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "build/web"
  }
}
