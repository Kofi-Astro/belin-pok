# Copy to .env and fill in real values (Supabase dashboard -> Project Settings -> API / Database).
# Never commit .env.

ENVIRONMENT=local

# Direct Postgres connection (SQLAlchemy + asyncpg). Use the "Transaction"
# pooler connection string from Supabase, with postgresql+asyncpg:// as the
# scheme instead of postgresql://.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Safe-ish (RLS still applies) but not committed anyway. Only used if the
# API ever needs to act as an anonymous/authenticated Supabase client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Full-bypass credential (equivalent to the old service_role key). Backend
# only -- used for Supabase Auth admin operations (inviting/managing staff
# accounts). Never send this to the Flutter app.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated list of allowed CORS origins -- the admin app,
# the storefront app, and their local dev ports.
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,https://admin.belpok.xyz,https://belpok.xyz,https://www.belpok.xyz

# Where staff invite emails send people to sign in. Must also be added to
# Supabase Dashboard -> Authentication -> URL Configuration -> Redirect
# URLs, or Supabase silently falls back to the project's Site URL instead.
ADMIN_APP_URL=https://admin.belpok.xyz

# Optional. Raw JSON (not a file path) of a Firebase service account key --
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Powers push notifications (app/push.py): order-status
# updates and back-in-stock alerts. Without it, those features silently
# no-op instead of failing -- see app/push.py.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
