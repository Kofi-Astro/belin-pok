# Copy to .env and fill in real values. Never commit .env.
# In production these are the Railway service's Variables instead.

ENVIRONMENT=local

# Postgres connection for SQLAlchemy + asyncpg -- note the
# postgresql+asyncpg:// scheme. On Railway, reference the Postgres
# service's URL and swap the scheme, e.g.
#   DATABASE_URL=postgresql+asyncpg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/belpok

# Signs access tokens (app/security.py). Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Optional overrides (defaults shown).
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30

# Comma-separated list of allowed CORS origins -- the admin app,
# the storefront app, and their local dev ports.
CORS_ORIGINS=http://localhost:5000,http://localhost:5001,https://admin.belpok.xyz,https://belpok.xyz,https://www.belpok.xyz

# Where invite / password-reset links point.
ADMIN_APP_URL=https://admin.belpok.xyz
STOREFRONT_URL=https://belpok.xyz

# Optional: sends invite and password-reset emails via Resend
# (https://resend.com). Without it nothing is emailed -- invite links are
# still shown to the owner in the Staff screen to share directly. The
# domain in EMAIL_FROM must be verified in Resend first.
RESEND_API_KEY=
EMAIL_FROM=Belin-Pok <no-reply@belpok.xyz>

# Optional. Raw JSON (not a file path) of a Firebase service account key --
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Powers push notifications (app/push.py): order-status
# updates and back-in-stock alerts. Without it, those features silently
# no-op instead of failing -- see app/push.py.
FIREBASE_SERVICE_ACCOUNT_JSON=
